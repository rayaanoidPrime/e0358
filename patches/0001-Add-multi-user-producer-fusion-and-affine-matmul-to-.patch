+++ b/mlir/lib/Target/CudaTile/AffineToCudaTile.cpp
@@ -0,0 +1,332 @@
+//===- AffineToCudaTile.cpp - Affine matmul nests to CUDA Tile IR ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Translates a function made of affine matmul nests,
+//
+//   for i, j: c[i, j] = 0
+//   for i, j, k: c[i, j] += a[i, k] * b[k, j]
+//
+// into a CUDA Tile IR module with one kernel per group of matmuls. Each kernel
+// block computes one tile of c, accumulating over k in f32.
+//
+// With sibling fusion, matmuls that read the same a (same shapes, and no
+// matmul writing what another reads) form one group: its kernel loads each
+// tile of a once and multiplies it with the tiles of every b.
+//
+// Each kernel is preceded by the line the runtime launches it from:
+//
+//   // launch @k0 grid=[8, 1] args=[1, 0, 4]
+//
+// args are the function argument numbers, in kernel parameter order.
+//
+//===----------------------------------------------------------------------===//
+
+#include "mlir/Dialect/Affine/IR/AffineOps.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/Dialect/MemRef/IR/MemRef.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/Matchers.h"
+#include "mlir/Tools/mlir-translate/Translation.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/FormatVariadic.h"
+
+using namespace mlir;
+using namespace mlir::affine;
+using llvm::formatv;
+
+namespace {
+/// c[m x n] += a[m x k] * b[k x n], on function arguments.
+struct Matmul {
+  BlockArgument a, b, c;
+  int64_t m, n, k;
+};
+} // namespace
+
+/// Returns the loops of the perfect nest rooted at `loop`, outermost first.
+static SmallVector<AffineForOp> perfectNest(AffineForOp loop) {
+  SmallVector<AffineForOp> nest = {loop};
+  while (llvm::hasSingleElement(nest.back().getBody()->without_terminator()))
+    if (auto inner = dyn_cast<AffineForOp>(nest.back().getBody()->front()))
+      nest.push_back(inner);
+    else
+      break;
+  return nest;
+}
+
+/// Returns the trip count of a loop from 0 with step 1, or 0 for other loops.
+static int64_t tripCount(AffineForOp loop) {
+  if (!loop.hasConstantBounds() || loop.getConstantLowerBound() != 0 ||
+      loop.getStepAsInt() != 1)
+    return 0;
+  return loop.getConstantUpperBound();
+}
+
+/// Returns the function argument that `op` accesses at exactly `ivs`.
+template <typename OpTy>
+static BlockArgument accessAt(OpTy op, ArrayRef<Value> ivs) {
+  if (!op || !op.getAffineMap().isIdentity() ||
+      !llvm::equal(op.getMapOperands(), ivs))
+    return nullptr;
+  auto arg = dyn_cast<BlockArgument>(op.getMemRef());
+  auto type = cast<MemRefType>(op.getMemRef().getType());
+  return arg && type.getLayout().isIdentity() ? arg : nullptr;
+}
+
+/// Matches `for i, j: c[i, j] = 0` and returns c.
+static BlockArgument matchZeroFill(AffineForOp loop) {
+  SmallVector<AffineForOp> nest = perfectNest(loop);
+  if (nest.size() != 2 || !tripCount(nest[0]) || !tripCount(nest[1]))
+    return nullptr;
+  auto store = dyn_cast<AffineStoreOp>(nest[1].getBody()->front());
+  if (!store || !matchPattern(store.getValue(), m_AnyZeroFloat()))
+    return nullptr;
+  return accessAt(store,
+                  {nest[0].getInductionVar(), nest[1].getInductionVar()});
+}
+
+/// Matches `for i, j, k: c[i, j] += a[i, k] * b[k, j]`.
+static std::optional<Matmul> matchMatmul(AffineForOp loop) {
+  SmallVector<AffineForOp> nest = perfectNest(loop);
+  if (nest.size() != 3)
+    return std::nullopt;
+  Value i = nest[0].getInductionVar(), j = nest[1].getInductionVar(),
+        k = nest[2].getInductionVar();
+  Block *body = nest[2].getBody();
+  auto store = dyn_cast<AffineStoreOp>(body->back().getPrevNode());
+  auto add = store ? store.getValue().getDefiningOp<arith::AddFOp>() : nullptr;
+  if (!add || body->getOperations().size() != 7)
+    return std::nullopt;
+  // c[i, j] + a * b, in either order.
+  Value acc = add.getLhs(), product = add.getRhs();
+  if (!product.getDefiningOp<arith::MulFOp>())
+    std::swap(acc, product);
+  auto mul = product.getDefiningOp<arith::MulFOp>();
+  if (!mul)
+    return std::nullopt;
+  Matmul mm{accessAt(mul.getLhs().getDefiningOp<AffineLoadOp>(), {i, k}),
+            accessAt(mul.getRhs().getDefiningOp<AffineLoadOp>(), {k, j}),
+            accessAt(store, {i, j}),
+            tripCount(nest[0]),
+            tripCount(nest[1]),
+            tripCount(nest[2])};
+  if (!mm.a || !mm.b || !mm.c || !mm.m || !mm.n || !mm.k ||
+      accessAt(acc.getDefiningOp<AffineLoadOp>(), {i, j}) != mm.c)
+    return std::nullopt;
+  return mm;
+}
+
+/// Whether `x` and `y` can share one kernel: the same a and shapes, and
+/// neither writes what the other reads.
+static bool fusable(const Matmul &x, const Matmul &y) {
+  return x.a == y.a && x.m == y.m && x.n == y.n && x.k == y.k &&
+         !llvm::is_contained({y.a, y.b}, x.c) &&
+         !llvm::is_contained({x.a, x.b}, y.c);
+}
+
+/// Tile sizes (m x n x k) for a group of `count` matmuls of `mm`'s shape,
+/// picked from measurements on an RTX 4090: 16-deep k tiles, enough blocks
+/// for its 128 SMs where the matrix allows it, and, in fused groups, where
+/// each matmul keeps its own accumulator, narrower tiles.
+static std::array<int64_t, 3> tileSizes(const Matmul &mm, size_t count) {
+  const int64_t numSMs = 128;
+  bool f32 = cast<MemRefType>(mm.a.getType()).getElementType().isF32();
+  auto blocks = [&](int64_t tm, int64_t tn) {
+    return (mm.m / tm) * (mm.n / tn);
+  };
+  int64_t tm = f32 && count == 1 ? 32 : 64;
+  if (blocks(tm, 32) < numSMs)
+    tm = 32;
+  int64_t tn = count == 1 ? 128 : f32 ? 32 : 64;
+  while (tn > 32 && (mm.n % tn || blocks(tm, tn) < numSMs))
+    tn /= 2;
+  return {tm, tn, 16};
+}
+
+/// Prints the kernel computing `group` as @k<id>, with tiles of `tm x tn` of
+/// c and `tk`-deep steps over k.
+static void printKernel(ArrayRef<Matmul> group, int id, int64_t tm, int64_t tn,
+                        int64_t tk, raw_ostream &os) {
+  const Matmul &mm = group.front();
+  std::string t;
+  llvm::raw_string_ostream(t)
+      << cast<MemRefType>(mm.a.getType()).getElementType();
+
+  // The tile types, and the types of a row-major matrix cut into tiles.
+  auto tile = [](int64_t rows, int64_t cols, StringRef type) {
+    return formatv("tile<{0}x{1}x{2}>", rows, cols, type).str();
+  };
+  auto tiles = [&](int64_t rows, int64_t cols, int64_t tr, int64_t tc) {
+    return formatv("partition_view<tile=({0}x{1}), tensor_view<{2}x{3}x{4}, "
+                   "strides=[{3},1]>>",
+                   tr, tc, rows, cols, t)
+        .str();
+  };
+  std::string aTile = tile(tm, tk, t), bTile = tile(tk, tn, t),
+              cTile = tile(tm, tn, t), acc = tile(tm, tn, "f32"),
+              aTiles = tiles(mm.m, mm.k, tm, tk),
+              bTiles = tiles(mm.k, mm.n, tk, tn),
+              cTiles = tiles(mm.m, mm.n, tm, tn);
+
+  // Joins `line(n)` over the matmuls n of the group.
+  auto each = [&](auto line, StringRef separator = "") {
+    SmallVector<std::string> lines;
+    for (size_t n = 0; n < group.size(); ++n)
+      lines.push_back(line(n));
+    return llvm::join(lines, separator);
+  };
+  // Defines %<name>_tiles, the matrix at %<name> cut into `type` tiles.
+  auto partition = [&](const Twine &name, int64_t rows, int64_t cols,
+                       StringRef type) {
+    return formatv("    %{0}_view = make_tensor_view %{0}, shape = [{1}, {2}], "
+                   "strides = [{2}, 1] : tensor_view<{1}x{2}x{3}, "
+                   "strides=[{2},1]>\n"
+                   "    %{0}_tiles = make_partition_view %{0}_view : {4}\n",
+                   name.str(), rows, cols, t, type)
+        .str();
+  };
+
+  os << formatv("  // launch @k{0} grid=[{1}, {2}] args=[{3}{4}]\n", id,
+                mm.m / tm, mm.n / tn, mm.a.getArgNumber(), each([&](size_t n) {
+                  return formatv(", {0}, {1}", group[n].b.getArgNumber(),
+                                 group[n].c.getArgNumber())
+                      .str();
+                }));
+  os << formatv("  entry @k{0}(%a: tile<ptr<{1}>>{2}) {{\n", id, t,
+                each([&](size_t n) {
+                  return formatv(", %b{0}: tile<ptr<{1}>>, %c{0}: "
+                                 "tile<ptr<{1}>>",
+                                 n, t)
+                      .str();
+                }));
+  os << "    %i, %j, %unused = get_tile_block_id : tile<i32>\n";
+  os << partition("a", mm.m, mm.k, aTiles) << each([&](size_t n) {
+    return partition("b" + Twine(n), mm.k, mm.n, bTiles) +
+           partition("c" + Twine(n), mm.m, mm.n, cTiles);
+  });
+
+  // for k: acc_n += a[i, k] * b_n[k, j], one f32 accumulator per matmul.
+  os << formatv("    %zero = constant <f32: 0.0> : {0}\n"
+                "    %k0 = constant <i32: 0> : tile<i32>\n"
+                "    %k1 = constant <i32: 1> : tile<i32>\n"
+                "    %kn = constant <i32: {1}> : tile<i32>\n",
+                acc, mm.k / tk);
+  os << formatv(
+      "    %acc:{0} = for %k in (%k0 to %kn, step %k1) : tile<i32> "
+      "iter_values({1}) -> ({2}) {{\n",
+      group.size(),
+      each([](size_t n) { return formatv("%acc{0} = %zero", n).str(); }, ", "),
+      each([&](size_t) { return acc; }, ", "));
+  os << formatv("      %x, %tx = load_view_tko weak %a_tiles[%i, %k] : {0}, "
+                "tile<i32> -> {1}, token\n",
+                aTiles, aTile);
+  os << each([&](size_t n) {
+    return formatv("      %w{0}, %tw{0} = load_view_tko weak %b{0}_tiles[%k, "
+                   "%j] : {1}, tile<i32> -> {2}, token\n"
+                   "      %sum{0} = mmaf %x, %w{0}, %acc{0} : {3}, {2}, {4}\n",
+                   n, bTiles, bTile, aTile, acc)
+        .str();
+  });
+  os << formatv(
+      "      continue {0} : {1}\n    }\n",
+      each([](size_t n) { return formatv("%sum{0}", n).str(); }, ", "),
+      each([&](size_t) { return acc; }, ", "));
+
+  // c_n[i, j] = acc_n, in the element type.
+  os << each([&](size_t n) {
+    std::string convert, result = formatv("%acc#{0}", n);
+    if (t != "f32") {
+      convert = formatv("    %c{0}_tile = ftof %acc#{0} : {1} -> {2}\n", n, acc,
+                        cTile);
+      result = formatv("%c{0}_tile", n);
+    }
+    return convert + formatv("    %s{0} = store_view_tko weak {1}, "
+                             "%c{0}_tiles[%i, %j] : {2}, {3}, tile<i32> -> "
+                             "token\n",
+                             n, result, cTile, cTiles)
+                         .str();
+  });
+  os << "    return\n  }\n";
+}
+
+static LogicalResult translateToCudaTile(ModuleOp module, raw_ostream &os,
+                                         bool siblingFusion) {
+  auto funcs = module.getOps<func::FuncOp>();
+  if (!llvm::hasSingleElement(funcs))
+    return module.emitError("expected a single function");
+  func::FuncOp func = *funcs.begin();
+
+  // Collect the matmuls and the buffers zeroed before them; anything else in
+  // the function cannot be translated.
+  SmallVector<Matmul> matmuls;
+  DenseSet<Value> zeroed;
+  for (Operation &op : func.getBody().front()) {
+    auto loop = dyn_cast<AffineForOp>(op);
+    if (BlockArgument c = loop ? matchZeroFill(loop) : nullptr) {
+      zeroed.insert(c);
+      continue;
+    }
+    if (std::optional<Matmul> mm = loop ? matchMatmul(loop) : std::nullopt) {
+      if (!zeroed.contains(mm->c))
+        return loop.emitError("matmul output is not zero-initialized");
+      matmuls.push_back(*mm);
+      continue;
+    }
+    if (!isa<arith::ConstantOp, func::ReturnOp>(op))
+      return op.emitError("not a matmul nest");
+  }
+
+  // Group the matmuls into kernels: each alone, or with its siblings.
+  SmallVector<SmallVector<Matmul>> groups;
+  for (const Matmul &mm : matmuls) {
+    auto group = llvm::find_if(groups, [&](ArrayRef<Matmul> g) {
+      return siblingFusion &&
+             llvm::all_of(g, [&](const Matmul &x) { return fusable(x, mm); });
+    });
+    if (group == groups.end())
+      groups.push_back({mm});
+    else
+      group->push_back(mm);
+  }
+
+  // Kernels cover whole tiles only.
+  SmallVector<std::array<int64_t, 3>> tiles;
+  for (ArrayRef<Matmul> group : groups) {
+    const Matmul &mm = group.front();
+    tiles.push_back(tileSizes(mm, group.size()));
+    auto [tm, tn, tk] = tiles.back();
+    if (mm.m % tm || mm.n % tn || mm.k % tk)
+      return func.emitError(formatv("matmul of {0}x{1}x{2} is not made of "
+                                    "{3}x{4}x{5} tiles",
+                                    mm.m, mm.n, mm.k, tm, tn, tk));
+  }
+
+  os << "cuda_tile.module @kernels {\n";
+  for (auto [id, group, tile] : llvm::enumerate(groups, tiles))
+    printKernel(group, id, tile[0], tile[1], tile[2], os);
+  os << "}\n";
+  return success();
+}
+
+namespace mlir {
+void registerToCudaTileTranslation() {
+  static llvm::cl::opt<bool> siblingFusion(
+      "cuda-tile-sibling-fusion",
+      llvm::cl::desc("Fuse matmuls that share their a operand"),
+      llvm::cl::init(false));
+  TranslateFromMLIRRegistration registration(
+      "affine-to-cuda-tile", "translate affine matmul nests to CUDA Tile IR",
+      [](ModuleOp module, raw_ostream &os) {
+        return translateToCudaTile(module, os, siblingFusion);
+      },
+      [](DialectRegistry &registry) {
+        registry.insert<AffineDialect, arith::ArithDialect, func::FuncDialect,
+                        memref::MemRefDialect>();
+      });
+}
