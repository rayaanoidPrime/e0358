+  DenseSet<unsigned> getAffineConsumers(unsigned producerId,
+                                        const DenseSet<Value> &memrefs) {
+    DenseSet<unsigned> consumers;
+    if (any_of(mdg->nodes, [&](const auto &idAndNode) {
+          return idAndNode.first != producerId &&
+                 any_of(memrefs, [&](Value memref) {
+                   return idAndNode.second.getStoreOpCount(memref) > 0;
+                 });
+        }))
+      return consumers;
+    for (const auto &edge : mdg->outEdges.lookup(producerId))
+      if (memrefs.count(edge.value) > 0 &&
+          mdg->getNode(edge.id)->getLoadOpCount(edge.value) > 0)
+        consumers.insert(edge.id);
+    return consumers;
+  }
+
+  bool isMultiUserFusionProfitable(unsigned srcId,
+                                   const DenseSet<unsigned> &consumers) {
+    Node *srcNode = mdg->getNode(srcId);
+    auto srcForOp = cast<AffineForOp>(srcNode->op);
+    LoopNestStats srcStats;
+    if (!getLoopNestStats(srcForOp, &srcStats))
+      return false;
+
+    bool hasCompute = false;
+    srcForOp.walk([&](Operation *op) {
+      hasCompute |= !isa<AffineForOp, AffineReadOpInterface,
+                         AffineWriteOpInterface, AffineYieldOp>(op);
+    });
+    double originalCost = getComputeCost(srcForOp, srcStats);
+    double fusedCost = 0;
+    double threshold =
+        hasCyclicDependence(srcForOp) ? 0 : computeToleranceThreshold;
+
+    for (unsigned dstId : consumers) {
+      Node *dstNode = mdg->getNode(dstId);
+      if (!isa<AffineForOp>(dstNode->op) || dstNode->op->getNumResults() > 0)
+        return false;
+      auto dstForOp = cast<AffineForOp>(dstNode->op);
+
+      LDBG() << "Multi-user consumer " << dstId << ":\n" << *dstNode->op;
+      DenseSet<Value> memrefs;
+      gatherProducerConsumerMemrefs(srcId, dstId, *mdg, memrefs);
+      SmallVector<ComputationSliceState, 8> slices;
+      unsigned maxLegalDepth =
+          computeFusionSlices(srcForOp, dstNode, memrefs, slices);
+      if (memrefs.empty() || maxLegalDepth == 0)
+        return false;
+
+      SmallVector<Operation *, 2> producerStores;
+      for (Operation *op : srcNode->stores)
+        if (memrefs.count(cast<AffineWriteOpInterface>(op).getMemRef()))
+          producerStores.push_back(op);
+      unsigned bestDepth = maxLegalDepth;
+      if (producerStores.empty() ||
+          !isFusionProfitable(srcForOp, producerStores, dstForOp, slices,
+                              maxLegalDepth, &bestDepth, threshold))
+        return false;
+
+      LoopNestStats dstStats;
+      int64_t pairFusedCost;
+      if (!getLoopNestStats(dstForOp, &dstStats) ||
+          !getFusionComputeCost(srcForOp, srcStats, dstForOp, dstStats,
+                                slices[bestDepth - 1], &pairFusedCost))
+        return false;
+      originalCost += getComputeCost(dstForOp, dstStats);
+      fusedCost += pairFusedCost;
+    }
+
+    double additionalCompute = hasCompute ? fusedCost / originalCost - 1 : 0;
+    LDBG() << "Multi-user additional compute fraction: "
+           << additionalCompute;
+    return additionalCompute <= threshold;
+  }
