+  /// Computes fusion slices for `srcForOp` into `dstNode` at every legal
+  /// depth and returns the deepest legal depth (0 if fusion is illegal).
+  unsigned computeFusionSlices(AffineForOp srcForOp, Node *dstNode,
+                               const DenseSet<Value> &memrefs,
+                               SmallVectorImpl<ComputationSliceState> &slices) {
+    auto dstForOp = cast<AffineForOp>(dstNode->op);
+    SmallVector<AffineForOp, 4> surroundingLoops;
+    getAffineForIVs(*dstForOp, &surroundingLoops);
+    SmallVector<Operation *, 2> dstMemrefOps;
+    for (Operation *op : dstNode->loads)
+      if (memrefs.count(cast<AffineReadOpInterface>(op).getMemRef()))
+        dstMemrefOps.push_back(op);
+    for (Operation *op : dstNode->stores)
+      if (memrefs.count(cast<AffineWriteOpInterface>(op).getMemRef()))
+        dstMemrefOps.push_back(op);
+    if (dstMemrefOps.empty())
+      return 0;
+    unsigned maxDepth =
+        getInnermostCommonLoopDepth(dstMemrefOps) - surroundingLoops.size();
+    slices.resize(maxDepth);
+    unsigned maxLegalDepth = 0;
+    FusionStrategy strategy(FusionStrategy::ProducerConsumer);
+    for (unsigned depth = 1; depth <= maxDepth; ++depth) {
+      FusionResult result =
+          affine::canFuseLoops(srcForOp, dstForOp,
+                               depth + surroundingLoops.size(),
+                               &slices[depth - 1], strategy);
+      if (result.value == FusionResult::Success)
+        maxLegalDepth = depth;
+    }
+    return maxLegalDepth;
+  }
